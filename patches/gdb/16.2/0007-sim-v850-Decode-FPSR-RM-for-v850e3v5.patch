From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Parthiban Nallathambi <parthiban@linumiz.com>
Date: Sun, 15 Nov 2026 14:56:55 +0530
Subject: [PATCH 7/9] sim: v850: Decode FPSR RM for v850e3v5

On v850e3v5 RM values 1, 2 and 3 select round toward zero, up and down.
The simulator used the older order, so directed rounding was wrong.

Signed-off-by: Parthiban Nallathambi <parthiban@linumiz.com>
---
 sim/testsuite/v850/fpu-rm.cgs | 24 ++++++++++++++++++++++++
 sim/v850/v850-sim.h           |  4 ++++
 2 files changed, 28 insertions(+)
 create mode 100644 sim/testsuite/v850/fpu-rm.cgs

diff --git a/sim/testsuite/v850/fpu-rm.cgs b/sim/testsuite/v850/fpu-rm.cgs
new file mode 100644
index 00000000000..1f5751ddb44
--- /dev/null
+++ b/sim/testsuite/v850/fpu-rm.cgs
@@ -0,0 +1,24 @@
+# v850 FPSR.RM rounding modes
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	.macro	fdiv rm r_pos r_neg
+	seti	\rm, r20
+	ldsr	r20, 6, 0
+	divf.s	r2, r1, r3
+	reg	r3, \r_pos
+	divf.s	r2, r4, r3
+	reg	r3, \r_neg
+	.endm
+
+	seti	0x3f800000, r1
+	seti	0x40400000, r2
+	seti	0xbf800000, r4
+
+	fdiv	0x00000000, 0x3eaaaaab, 0xbeaaaaab
+	fdiv	0x00040000, 0x3eaaaaaa, 0xbeaaaaaa
+	fdiv	0x00080000, 0x3eaaaaab, 0xbeaaaaaa
+	fdiv	0x000c0000, 0x3eaaaaaa, 0xbeaaaaab
+
+	pass
diff --git a/sim/v850/v850-sim.h b/sim/v850/v850-sim.h
index 10220fd70f4..ba66cd0573e 100644
--- a/sim/v850/v850-sim.h
+++ b/sim/v850/v850-sim.h
@@ -216,6 +216,10 @@ nia = PC
 
 #define FPSR_GET_ROUND()					\
   (((FPSR & FPSR_RM) == FPSR_RN) ? sim_fpu_round_near		\
+   : (idecode_issue == idecode_v850e3v5_issue)			\
+   ? (((FPSR & FPSR_RM) == 0x00040000) ? sim_fpu_round_zero	\
+      : ((FPSR & FPSR_RM) == 0x00080000) ? sim_fpu_round_up	\
+      : sim_fpu_round_down)					\
    : ((FPSR & FPSR_RM) == 0x00040000) ? sim_fpu_round_up	\
    : ((FPSR & FPSR_RM) == 0x00080000) ? sim_fpu_round_down	\
    : sim_fpu_round_zero)
