From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Parthiban Nallathambi <parthiban@linumiz.com>
Date: Sun, 15 Nov 2026 14:56:55 +0530
Subject: [PATCH 8/9] sim: v850: Flush subnormals when FPSR FS is set

With FS set the FPU flushes subnormal operands and results to zero and
reports it in the flags. The simulator passed subnormals through.

Signed-off-by: Parthiban Nallathambi <parthiban@linumiz.com>
---
 sim/testsuite/v850/fpu-fs.cgs |  83 +++++++++++++++
 sim/v850/simops.c             |  95 ++++++++++++++++-
 sim/v850/simops.h             |   4 +
 sim/v850/v850-sim.h           |   2 +
 sim/v850/v850.igen            | 192 +++++++++++++++++-----------------
 5 files changed, 278 insertions(+), 98 deletions(-)
 create mode 100644 sim/testsuite/v850/fpu-fs.cgs

diff --git a/sim/testsuite/v850/fpu-fs.cgs b/sim/testsuite/v850/fpu-fs.cgs
new file mode 100644
index 00000000000..23fafdbc6b8
--- /dev/null
+++ b/sim/testsuite/v850/fpu-fs.cgs
@@ -0,0 +1,83 @@
+# v850 FPSR.FS flush of subnormal operands and results
+# mach: v850e3v5
+
+	.include "testutils.inc"
+
+	.macro	fpsr val
+	seti	\val, r20
+	ldsr	r20, 6, 0
+	.endm
+
+	.macro	fpsr_if exp
+	stsr	6, r20, 0
+	seti	0x00400000, r21
+	and	r21, r20
+	reg	r20, \exp
+	.endm
+
+	seti	0x3f800000, r1
+
+# Input operand: +-subnormal becomes +-0 and sets FPSR.IF
+	fpsr	0x00020000
+	seti	0x00000001, r2
+	mulf.s	r1, r2, r3
+	reg	r3, 0
+	fpsr_if	0x00400000
+	fpsr	0x00020000
+	seti	0x80000001, r2
+	mulf.s	r1, r2, r3
+	reg	r3, 0x80000000
+
+# ABSF.S does not flush its operand
+	seti	0x80000001, r2
+	absf.s	r2, r3
+	reg	r3, 0x00000001
+
+# Result: 2^-100 * 2^-30 is subnormal before rounding
+	seti	0x0d800000, r4
+	seti	0x30800000, r5
+	seti	0x8d800000, r6
+
+	fpsr	0x00020000
+	mulf.s	r4, r5, r3
+	reg	r3, 0
+	fpsr_if	0
+	fpsr	0x00060000
+	mulf.s	r4, r5, r3
+	reg	r3, 0
+	fpsr	0x000a0000
+	mulf.s	r4, r5, r3
+	reg	r3, 0x00800000
+	mulf.s	r6, r5, r3
+	reg	r3, 0x80000000
+	fpsr	0x000e0000
+	mulf.s	r4, r5, r3
+	reg	r3, 0
+	mulf.s	r6, r5, r3
+	reg	r3, 0x80800000
+
+# RN with FN: 1.5 * 2^-127 goes to 2^-126, 2^-130 to 0
+	seti	0x20400000, r7
+	seti	0x1f800000, r8
+	fpsr	0x00820000
+	mulf.s	r7, r8, r3
+	reg	r3, 0x00800000
+	mulf.s	r4, r5, r3
+	reg	r3, 0
+
+# Double: 2^-600 * 2^-500 is flushed to +0
+	mov	0, r10
+	seti	0x1a700000, r11
+	mov	0, r12
+	seti	0x20b00000, r13
+	fpsr	0x00020000
+	mulf.d	r10, r12, r14
+	reg	r14, 0
+	reg	r15, 0
+
+# FS = 0 keeps the subnormal result
+	fpsr	0x00000000
+	mulf.s	r4, r5, r3
+	reg	r3, 0x00080000
+
+	pass
diff --git a/sim/v850/simops.c b/sim/v850/simops.c
index e2799af80e1..ac1a107fe54 100644
--- a/sim/v850/simops.c
+++ b/sim/v850/simops.c
@@ -2804,13 +2804,104 @@ OP_307E0 (void)
   sim_fpu_status_denorm = 16384,				----U (sim spec.)
 */  
     
+static int fpu_input_flushed;
+
 void
-update_fpsr (SIM_DESC sd, sim_fpu_status status, unsigned int mask, unsigned int double_op_p)
+v850_fpu_32to (sim_fpu *f, uint32_t s)
 {
-  unsigned int fpsr = FPSR & mask;
+  SIM_DESC sd = simulator;
+
+  sim_fpu_32to (f, s);
+  if ((FPSR & FPSR_FS) && sim_fpu_is_denorm (f))
+    {
+      sim_fpu_32to (f, s & 0x80000000);
+      FPSR |= FPSR_IF;
+      fpu_input_flushed = 1;
+    }
+}
 
+void
+v850_fpu_232to (sim_fpu *f, uint32_t h, uint32_t l)
+{
+  SIM_DESC sd = simulator;
+
+  sim_fpu_232to (f, h, l);
+  if ((FPSR & FPSR_FS) && sim_fpu_is_denorm (f))
+    {
+      sim_fpu_232to (f, h & 0x80000000, 0);
+      FPSR |= FPSR_IF;
+      fpu_input_flushed = 1;
+    }
+}
+
+static int
+v850_fpu_flush_result (sim_fpu *f, sim_fpu_round round, int double_p)
+{
+  SIM_DESC sd = simulator;
+  int emin = double_p ? -1022 : -126;
+  int to_min;
+
+  if (!(FPSR & FPSR_FS)
+      || f->class != sim_fpu_class_number
+      || f->normal_exp >= emin)
+    return 0;
+
+  switch (round)
+    {
+    case sim_fpu_round_up:
+      to_min = !f->sign;
+      break;
+    case sim_fpu_round_down:
+      to_min = f->sign;
+      break;
+    case sim_fpu_round_near:
+      to_min = (FPSR & FPSR_FN) && f->normal_exp == emin - 1;
+      break;
+    default:
+      to_min = 0;
+      break;
+    }
+
+  if (double_p)
+    sim_fpu_232to (f, ((f->sign ? 0x80000000 : 0)
+		       | (to_min ? 0x00100000 : 0)), 0);
+  else
+    sim_fpu_32to (f, (f->sign ? 0x80000000 : 0) | (to_min ? 0x00800000 : 0));
+  return sim_fpu_status_underflow | sim_fpu_status_inexact;
+}
+
+int
+v850_fpu_round_32 (sim_fpu *f, sim_fpu_round round, sim_fpu_denorm denorm)
+{
+  int status = v850_fpu_flush_result (f, round, 0);
+
+  return status ? status : sim_fpu_round_32 (f, round, denorm);
+}
+
+int
+v850_fpu_round_64 (sim_fpu *f, sim_fpu_round round, sim_fpu_denorm denorm)
+{
+  int status = v850_fpu_flush_result (f, round, 1);
+
+  return status ? status : sim_fpu_round_64 (f, round, denorm);
+}
+
+void
+update_fpsr (SIM_DESC sd, sim_fpu_status status, unsigned int mask, unsigned int double_op_p)
+{
+  unsigned int fpsr;
   unsigned int flags = 0;
 
+  if (fpu_input_flushed
+      && !(status & (sim_fpu_status_invalid_snan | sim_fpu_status_invalid_isi
+		     | sim_fpu_status_invalid_idi | sim_fpu_status_invalid_zdz
+		     | sim_fpu_status_invalid_imz | sim_fpu_status_invalid_cvi
+		     | sim_fpu_status_invalid_div0
+		     | sim_fpu_status_invalid_sqrt)))
+    status |= sim_fpu_status_inexact;
+  fpu_input_flushed = 0;
+  fpsr = FPSR & mask;
+
   if (fpsr & FPSR_XEI
       && ((status & (sim_fpu_status_rounded
 		     | sim_fpu_status_overflow
